# 复制为 deploy.env 后填写，deploy.env 已被 gitignore，不会进版本库。
#   cp deploy.env.example deploy.env
#   ./scripts/aiops-deploy.sh
#
# 留空的项会以"未配置"的方式优雅跳过，不影响诊断本身。

# --- 被诊断的对象，一般不用改 ---
COLLECTOR_STACK=zuoye-collector
ECS_CLUSTER=zuoye-cluster
AWS_REGION=us-east-2
DIAGNOSIS_WINDOW_MINUTES=60

# --- 飞书群通知：自定义机器人 ---
# 群设置 -> 机器人 -> 添加自定义机器人，复制 webhook 地址。
# 这个地址本身就是凭证，拿到它就能往群里发消息。
FEISHU_WEBHOOK=
# 机器人开了签名校验才填，没开就留空
FEISHU_SECRET=

# --- 飞书多维表格工单：自建应用 ---
# 开发者后台 https://open.feishu.cn/app 里那个应用的凭证。
# 应用需要申请这些权限并发布版本：base:app:read、base:record:read、base:record:create
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# --- 工单表格坐标（已由 lark-cli 建好，通常不用改）---
BASE_APP_TOKEN=XKI8b7XLVapJiVscKSecnPOqn2d
BASE_TABLE_ID=tblRGcK1dDawSpsN
