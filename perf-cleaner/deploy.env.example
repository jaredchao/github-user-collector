# Copy to deploy.env (gitignored) and fill in. Read by scripts/perf-deploy.sh
# and passed to CloudFormation as a NoEcho parameter, so it never lands in
# shell history or the repository.

# What the ECS task gets. The container runs inside the VPC and reaches RDS
# directly, so this is the real endpoint.
DATABASE_URL=postgres://appuser:password@database-1.xxxx.us-east-2.rds.amazonaws.com:5432/github_users?sslmode=no-verify

# RDS is not publicly accessible, so the migration cannot use the address
# above from a laptop or a CI runner. Open an SSM tunnel through the bastion
# and point this at it:
#
#   aws ssm start-session --target i-0453f29271df01fd4 \
#     --document-name AWS-StartPortForwardingSessionToRemoteHost \
#     --parameters '{"host":["database-1.xxxx.us-east-2.rds.amazonaws.com"],"portNumber":["5432"],"localPortNumber":["15432"]}'
#
# MIGRATION_DATABASE_URL=postgres://appuser:password@localhost:15432/github_users
#
# Or set SKIP_MIGRATION=1 once the perf_* tables already exist.

# Browser origins allowed to POST telemetry. Empty means any origin, which is
# the usual choice for a write-only endpoint.
SDK_ALLOWED_ORIGINS=https://zuoye-frontend.pages.dev

# Origins allowed to read the query API. Leave empty while developing locally.
DASHBOARD_ORIGINS=https://zuoye-perf-dashboard.pages.dev

# Optional overrides
# AWS_REGION=us-east-2
# ECS_CLUSTER=zuoye-cluster
# PERF_HOST=perf.go-api.jccode.cc
# RAW_LOG_GROUP=/perf/raw
