# Query API served by the perf-cleaner service on ECS, behind the ALB.
VITE_PERF_API_URL=https://perf.go-api.jccode.cc

# Site the dashboard opens on. The selector lists whatever else is reporting.
VITE_DEFAULT_SITE=zuoye-frontend

# Ingest endpoint the dashboard reports its OWN performance to, so the chain
# has a live producer. Leave empty locally to run without the AWS chain.
VITE_INGEST_URL=
VITE_TELEMETRY_SITE=perf-dashboard
