{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Types only. Vite emits the JavaScript; this exists so a consumer that
    // installs the package via file: gets real types instead of `any`.
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist"
  },
  "include": ["src"]
}
